{
  "name": "@stealthscale/theme-base",
  "version": "0.1.0",
  "description": "Solves the base theme a stealth product starts from, and ships its stylesheets and its tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "themes/base"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "tooling-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./*.css": "./dist/*.css",
    "./values": "./dist/values.mjs"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./*.css": "./dist/*.css",
      "./values": "./dist/values.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@stealthscale/core-theme": "workspace:^",
    "@tailwindcss/typography": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@stealthscale/tool-config": "workspace:^"
  },
  "stealth": {
    "appearance": {
      "densities": [
        "comfortable",
        "compact",
        "touch"
      ],
      "stylesheets": [
        "./dist/index.css"
      ]
    },
    "theme": {
      "title": "Base"
    }
  }
}
