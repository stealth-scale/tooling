{
  "name": "@stealthscale/tool-storybook",
  "version": "0.0.0",
  "description": "Builds the catalogue a repository ships: what a story is written with, the Storybook config, and the toolbars that drive the document.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "tools/storybook"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "dependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "magic-string": "catalog:",
    "playwright": "catalog:",
    "react-docgen": "catalog:",
    "storybook-addon-pseudo-states": "catalog:"
  },
  "devDependencies": {
    "@stealthscale/tool-config": "workspace:^",
    "@stealthscale/tool-testing": "workspace:^",
    "@storybook/react-vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:"
  },
  "peerDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:",
    "storybook": "catalog:"
  }
}
