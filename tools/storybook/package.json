{
  "name": "@stealthscale/tool-storybook",
  "version": "0.1.0",
  "description": "Builds a repository's Storybook: what a story is written with, the config derived from the workspace, the toolbars that drive the document, and the pages that document a theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "tools/storybook"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "./src/manager.ts",
    "./src/preview/index.ts",
    "./dist/manager.mjs",
    "./dist/preview/index.mjs"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "tooling-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "tooling-source": "./src/config/index.ts",
      "default": "./dist/config/index.mjs"
    },
    "./docs": {
      "tooling-source": "./src/docs/index.ts",
      "default": "./dist/docs/index.mjs"
    },
    "./manager": {
      "tooling-source": "./src/manager.ts",
      "default": "./dist/manager.mjs"
    },
    "./preset": {
      "tooling-source": "./src/preset.ts",
      "default": "./dist/preset.mjs"
    },
    "./preview": {
      "tooling-source": "./src/preview/index.ts",
      "default": "./dist/preview/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./config": "./dist/config/index.mjs",
      "./docs": "./dist/docs/index.mjs",
      "./manager": "./dist/manager.mjs",
      "./preset": "./dist/preset.mjs",
      "./preview": "./dist/preview/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/config/index.ts src/docs/index.ts src/manager.ts src/preset.ts src/preview/index.ts"
  },
  "dependencies": {
    "@stealthscale/core-appearance": "workspace:^",
    "@stealthscale/core-logging": "workspace:^",
    "@stealthscale/core-result": "workspace:^",
    "@stealthscale/core-schema": "workspace:^",
    "@stealthscale/core-theme": "workspace:^",
    "@stealthscale/tool-config": "workspace:^",
    "@stealthscale/tool-workspace": "workspace:^",
    "magic-string": "catalog:",
    "react-docgen": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@stealthscale/tool-testing": "workspace:^",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "storybook-addon-pseudo-states": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "storybook-addon-pseudo-states": "catalog:",
    "vite-plus": "catalog:"
  }
}
