{
  "name": "@stealthscale/core-logging",
  "version": "0.1.0",
  "description": "The contract a library logs through, so a package reports what it did without choosing where the words go.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "core/logging"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "tooling-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "devDependencies": {
    "@stealthscale/tool-config": "workspace:^"
  }
}
