{
  "name": "@stealthscale/core-theme",
  "version": "0.3.0",
  "description": "Defines the tokens a theme must set, solves a palette that clears WCAG contrast, and writes the stylesheet a theme ships.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "core/theme"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "tooling-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./write": {
      "tooling-source": "./src/write.ts",
      "default": "./dist/write.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./write": "./dist/write.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/write.ts"
  },
  "dependencies": {
    "@stealthscale/core-schema": "workspace:^"
  },
  "devDependencies": {
    "@stealthscale/tool-config": "workspace:^"
  }
}
