{
  "name": "@stealthscale/tool-config",
  "version": "0.1.2",
  "description": "The toolchain every stealth repository runs: how files are formatted, what the linter enforces, how libraries are packed and how specifications run, with the tsconfig bases beside it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "tools/config"
  },
  "files": [
    "dist",
    "tsconfig"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "tooling-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react.json": "./tsconfig/react.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./tsconfig/base.json": "./tsconfig/base.json",
      "./tsconfig/react.json": "./tsconfig/react.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "devDependencies": {
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "vite-plus": "catalog:"
  }
}
