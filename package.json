{
  "name": "@stealthscale/tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Holds the core libraries every stealth tier stands on, and the toolchain that builds, checks, tests and releases a repository.",
  "workspaces": {
    "packages": [
      "core/*",
      "tools/*"
    ],
    "catalog": {
      "@arethetypeswrong/core": "^0.18.5",
      "@changesets/cli": "^3.0.2",
      "@faker-js/faker": "^10.6.0",
      "@storybook/react-vite": "^10.6.0",
      "@testing-library/react": "^16.3.3",
      "@types/node": "^24",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "@vitest/coverage-v8": "4.1.11",
      "citty": "~0.2.2",
      "eslint-plugin-jsdoc": "^64.3.4",
      "eslint-plugin-perfectionist": "^5.11.0",
      "jsdom": "^30.0.1",
      "magic-string": "^0.30.21",
      "publint": "^0.3.24",
      "react": "^19.2.8",
      "react-docgen": "^8.0.3",
      "react-dom": "^19.2.8",
      "storybook": "^10.6.0",
      "typescript": "^7.0.2",
      "valibot": "^1.4.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
      "vite-plus": "0.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "catalog:",
    "@stealthscale/tool-cli": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.0"
}
