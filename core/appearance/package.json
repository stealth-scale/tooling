{
  "name": "@stealthscale/core-appearance",
  "version": "0.1.2",
  "description": "How a product is drawn for one person, as one value: theme, mode, density, motion, locale and direction, read from the machine, written on the document, checked at a boundary.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/tooling.git",
    "directory": "core/appearance"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "tooling-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts"
  },
  "dependencies": {
    "@stealthscale/core-locale": "workspace:^",
    "@stealthscale/core-schema": "workspace:^"
  },
  "devDependencies": {
    "@stealthscale/tool-config": "workspace:^"
  }
}
